generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum TipoUsuario {
  ALUNO
  APOIADOR
}

enum StatusConversa {
  ABERTA
  ENCERRADA
}

model User {
  id          Int         @id @default(autoincrement())
  username    String      @unique
  email       String      @unique
  senhaHash   String
  nomeReal    String?
  tipo        TipoUsuario
  criadoEm    DateTime    @default(now())

  apoiador    Supporter?
  conversas   Conversation[] @relation("AlunoConversas")
  mensagens   Message[]
}

model Supporter {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  funcao      String
  descricao   String?
  disponivel  Boolean  @default(true)
  criadoEm    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  conversas  Conversation[]
}

model Conversation {
  id                   Int            @id @default(autoincrement())
  alunoId              Int
  supporterId          Int
  anonima              Boolean        @default(true)
  identidadeRevelada   Boolean        @default(false)
  status               StatusConversa @default(ABERTA)
  criadaEm             DateTime       @default(now())
  encerradaEm          DateTime?

  aluno                User           @relation("AlunoConversas", fields: [alunoId], references: [id])
  supporter            Supporter      @relation(fields: [supporterId], references: [id])
  mensagens            Message[]
}

model Message {
  id              Int      @id @default(autoincrement())
  conversationId  Int
  remetenteId     Int
  conteudo        String
  enviadaEm       DateTime @default(now())

  conversa        Conversation @relation(fields: [conversationId], references: [id])
  remetente       User         @relation(fields: [remetenteId], references: [id])
}